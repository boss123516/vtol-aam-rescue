<?xml version="1.0" encoding="UTF-8"?>
<!--
  krac24(cjfgus814123/krac24) 통합: 단일 AUTO.MISSION 플랜 + WaypointReached 트리거 기반 설계.
  세부 배경은 /home/boss/.claude/plans/jolly-baking-catmull.md 참조.

  아래 웨이포인트 시퀀스(seq)는 실제 way3.plan(9개 항목, seq 0~8)에 맞춰 조정됨:
  seq0 TAKEOFF_HOME_DIRECT_RESCUE, seq1 REP_DIRECT,
  seq2~6 WP5~1_BACK, seq7 HOME_RETURN,
  seq8 HOME_VTOL_LAND(PX4 mission feasibility/safety net).
  krac_bt_params.yaml 의 동일 이름 파라미터(rescue_wp_seq, resume_wp_seq, landing_wp_seq,
  safe_ascend_alt)와 반드시 일치시킬 것. REP 저고도/재상승은 PX4 mission item에서
  제거했고 BT OFFBOARD 정밀착륙/재상승으로만 수행한다. way3.plan에는 드롭존 웨이포인트가 없으므로
  CruiseToDrop/DropOperation/ResumeAfterDrop은 MissionSequence에서 제외되어 있음
  (docs/krac24_integration.md Open items 참고, 실제 드롭존 좌표 확정 시 재활성화 필요).
-->
<root BTCPP_format="4" main_tree_to_execute="KRAC_Mission_BT">

  <BehaviorTree ID="KRAC_Mission_BT">
    <ReactiveFallback name="RootReactiveFallback">
      <SubTree ID="EmergencyBranch"/>
      <ReactiveSequence name="SafetyGuardedMission">
        <SubTree ID="SafetyGuard"/>
        <Sequence name="MissionSequence">
          <SubTree ID="MissionUpload"/>
          <SubTree ID="PreflightCheck"/>
          <SubTree ID="TakeoffPhase"/>
          <SubTree ID="CruiseToRescue"/>
          <Fallback name="RescueOperationOrSkipIfCompleted">
            <IsRescueCompleted/>
            <SubTree ID="RescueOperation"/>
          </Fallback>
          <SubTree ID="ResumeAfterRescue"/>
          <!-- CruiseToDrop/DropOperation/ResumeAfterDrop disabled: way3.plan has no
               drop-zone waypoint yet. Re-enable once a real seq is available. -->
          <SubTree ID="CruiseToLanding"/>
          <SubTree ID="FinalLanding"/>
        </Sequence>
      </ReactiveSequence>
      <GlobalMissionRecovery reason="unhandled_mission_or_guard_failure"/>
    </ReactiveFallback>
  </BehaviorTree>

  <BehaviorTree ID="EmergencyBranch">
    <Sequence name="EmergencyBranch">
      <IsEmergencyDetected sources="px4_failsafe,mavros_loss,gps_loss,battery_critical,manual_abort,geofence"/>
      <EmergencyRecovery policy="hold_if_possible_else_px4_failsafe"/>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="SafetyGuard">
    <Sequence name="SafetyGuard">
      <!-- Keep the top-level guard deliberately narrow in SITL. Earlier versions
           also gated every tick on GPS/global-position freshness; those topics
           can transiently miss the 2s window during PX4 startup or CPU load.
           Because this is inside a ReactiveSequence, any transient failure halts
           MissionSequence, then the root fallback starts GlobalMissionRecovery.
           Before arming that repeatedly cleared/re-uploaded the mission; after
           arming it repeatedly injected hold/zero-velocity behavior. PX4/QGC
           still own the real preflight/failsafe checks, so the BT guard only
           verifies that MAVROS is connected. -->
      <IsMAVROSConnected max_state_age_sec="5.0"/>
      <IsBatterySafe sim_bypass="true" min_voltage="0.0" min_percentage="0.0"/>
    </Sequence>
  </BehaviorTree>

  <!-- A transient SafetyGuard failure (e.g. one missed MAVROS heartbeat under
       CPU load) makes the parent ReactiveSequence halt and restart
       MissionSequence from here. If that happens after takeoff the vehicle
       is armed and airborne in FW, so re-running the ground-start
       arm/OFFBOARD dance below would be wrong, and its last check,
       IsVTOLStateMC, would fail forever (confirmed live: this permanently
       wedged the tree after a mid-cruise reconnect blip). Skip straight past
       once already armed. -->
  <!-- No OFFBOARD here (COM_PREARM_MODE governs actuator pre-arming, not
       this - arming works in any mode once prearm checks pass). Live testing
       showed arming+briefly holding in OFFBOARD before immediately switching
       to AUTO.MISSION correlated with the native VTOL takeoff/transition
       (item #0) intermittently Quad-chuting, vs. the known-good manual flow
       which arms and goes straight to AUTO.MISSION with no OFFBOARD step at
       all. Mirrored here. -->
  <BehaviorTree ID="PreflightCheck">
    <Fallback name="PreflightCheckOrSkipIfAlreadyArmed">
      <IsVehicleArmed/>
      <Sequence name="PreflightCheck">
        <SetMissionPhase phase="0"/>
        <RetryUntilSuccessful num_attempts="3">
          <Sequence name="ArmAndVerify">
            <ArmVehicle arm="true" timeout_sec="5.0"/>
            <IsVehicleArmed/>
          </Sequence>
        </RetryUntilSuccessful>
        <IsVTOLStateMC/>
      </Sequence>
    </Fallback>
  </BehaviorTree>

  <!-- Deliberately does NOT climb via OFFBOARD here. way3.plan's item #0 is a
       MAV_CMD_NAV_VTOL_TAKEOFF to this same 10m altitude; if the BT climbs
       there first via OFFBOARD, the vehicle is already airborne at the
       takeoff target the instant AUTO.MISSION starts, so PX4 never runs its
       own ground-start VTOL takeoff/transition sequence and instead attempts
       an immediate FW transition from an OFFBOARD hover. This reliably
       triggered a Quad-chute in live SITL testing. The known-good manual/
       legacy flow just arms and switches straight to AUTO.MISSION from the
       ground, letting PX4's native VTOL_TAKEOFF item fly the climb+
       transition itself. Mirrored here: this subtree now only marks the
       phase; MissionUpload's AUTO.MISSION switch (from the ground) does the
       actual takeoff. -->
  <BehaviorTree ID="TakeoffPhase">
    <Sequence name="TakeoffPhase">
      <SetMissionPhase phase="1"/>
    </Sequence>
  </BehaviorTree>

  <!-- Upload before arming. PX4 standard_vtol rejects arming in AUTO.MISSION
       when the current mission is empty or fails feasibility checks. Same
       reset hazard as PreflightCheck: if a transient SafetyGuard blip
       restarts MissionSequence after the mission is already uploaded and
       airborne or landed-but-armed in OFFBOARD, re-clearing/re-uploading
       way3.plan here would reset progress back to seq 0 mid-flight. Skip
       whenever the vehicle is already armed. -->
  <BehaviorTree ID="MissionUpload">
    <Fallback name="MissionUploadOrSkipIfAlreadyRunning">
      <IsVehicleArmed/>
      <Sequence name="MissionUpload">
        <ClearMissionPlan optional="true"/>
        <RetryUntilSuccessful num_attempts="2">
          <Sequence name="LoadFullMission">
            <UploadMissionPlan plan_path="way3.plan" mission_name="full_route" expected_end="LANDING"/>
            <IsMissionUploaded mission_name="full_route" expected_end="LANDING"/>
          </Sequence>
        </RetryUntilSuccessful>
        <RetryUntilSuccessful num_attempts="3">
          <Sequence name="StartMission">
            <SetFlightMode mode="AUTO.MISSION" timeout_sec="5.0"/>
            <IsFlightMode mode="AUTO.MISSION"/>
          </Sequence>
        </RetryUntilSuccessful>
      </Sequence>
    </Fallback>
  </BehaviorTree>

  <BehaviorTree ID="CruiseToRescue">
    <!-- rescue_wp_seq (krac_bt_params.yaml 기본값 1 = REP_DIRECT 도착).
         In SITL the camera can see the REP marker before PX4 reports seq1
         reached. Trigger rescue on either event so fixed-wing cruise does not
         fly past the visual target before the VTOL handover starts. -->
    <Sequence name="CruiseUntilRescueTrigger">
      <Fallback name="RescueTriggerTargetOrWaypoint">
        <IsPrecisionTargetDetected max_age_sec="2.0"/>
        <WaitForWaypointReached seq="1" timeout_sec="600.0"/>
      </Fallback>
    </Sequence>
  </BehaviorTree>

  <!--
    krac24 vtol_fsm.cpp(프록시 FSM) 이식: mission-plan 비행 중 이 지점에서만 OFFBOARD로 개입해
    precision_lander(정밀 PID+yaw 정렬, TargetError 기반)에 착륙/픽업을 위임한다.
  -->
  <BehaviorTree ID="RescueOperation">
    <RetryUntilSuccessful num_attempts="4">
      <Fallback name="RescueOperationWithLocalRecovery">
        <Sequence name="RescueOperationAttempt">
          <SetMissionPhase phase="7"/>
          <StartOffboardSetpointStream mode="hold_current_pose" rate_hz="20"/>
          <IsOffboardSetpointStreamAlive min_rate_hz="10" stable_duration_sec="1.0"/>
          <SetFlightMode mode="OFFBOARD" timeout_sec="5.0"/>
          <IsFlightMode mode="OFFBOARD"/>
          <CommandVTOLTransition target_state="MC" timeout_sec="20.0"/>
          <IsVTOLStateMC/>
          <FlyToLocalPoint x_m="130.0" y_m="35.0" z_m="10.0" xy_tolerance_m="0.5" z_tolerance_m="1.0" max_xy_speed_mps="2.0" max_z_speed_mps="0.8" timeout_sec="80.0"/>
          <WaitForHoverStable altitude_tolerance_m="40.0" max_vertical_speed_mps="0.8" max_horizontal_speed_mps="2.0" stable_duration_sec="0.5" timeout_sec="12.0"/>
          <SetMissionPhase phase="8"/>
          <DeactivateYOLO/>
          <WaitForPrecisionTarget max_age_sec="4.0" timeout_sec="45.0"/>
          <EnablePrecisionLander enable="true"/>
          <PrecisionLandOnTarget target_altitude_m="0.8" timeout_sec="90.0" target_fresh_max_age_sec="10.0"/>
          <CloseGripper left_topic="/model/standard_vtol_0/servo_5" right_topic="/model/standard_vtol_0/servo_6" left_position="0.5" right_position="0.5" timeout_sec="5.0"/>
          <VerifyBasketPicked method="gripper_feedback_or_visual_invariant" lift_test_height_m="0.5" timeout_sec="10.0"/>
          <EnablePrecisionLander enable="false"/>
        </Sequence>
        <Sequence name="RecoverRescueThenRetry">
          <EnablePrecisionLander enable="false"/>
          <RecoverVisionLanding policy="hover_climb_reacquire" climb_altitude_m="1.5" timeout_sec="20.0"/>
          <FailAfterRecovery/>
        </Sequence>
      </Fallback>
    </RetryUntilSuccessful>
  </BehaviorTree>

  <!-- 구조 후에는 OFFBOARD에서 안전 고도로 재상승한 뒤 WP5_BACK(seq2)부터
       AUTO.MISSION을 재개한다. REP 저고도/재상승 mission item은 제거되어,
       REP/final landing 외 구간은 고정익 AUTO.MISSION으로만 진행된다. -->
  <BehaviorTree ID="ResumeAfterRescue">
    <Sequence name="ResumeAfterRescue">
      <FlyToAltitude target_altitude_m="30.0" tolerance_m="1.0" max_climb_rate_mps="1.2" hold_latlon="true" timeout_sec="60.0"/>
      <IsAltitudeReached target_altitude_m="30.0" tolerance_m="1.0"/>
      <AlignHeadingToWaypoint seq="2" tolerance_rad="0.05" timeout_sec="8.0"/>
      <SetMissionCurrentWaypoint seq="2" timeout_sec="5.0"/>
      <CommandVTOLTransition target_state="FW" timeout_sec="20.0"/>
      <RetryUntilSuccessful num_attempts="3">
        <Sequence name="ResumeAutoMission">
          <SetFlightMode mode="AUTO.MISSION" timeout_sec="5.0"/>
          <IsFlightMode mode="AUTO.MISSION"/>
        </Sequence>
      </RetryUntilSuccessful>
    </Sequence>
  </BehaviorTree>

  <!-- 현재 MissionSequence에서 미참조 (way3.plan에 드롭존 웨이포인트 없음). -->
  <BehaviorTree ID="CruiseToDrop">
    <!-- disabled placeholder: 실제 드롭존 좌표/seq 확정 시 갱신 -->
    <WaitForWaypointReached seq="999" timeout_sec="600.0"/>
  </BehaviorTree>

  <!--
    krac24에는 없는 구간(하기/DROP_RESCUEE). precision_lander 대신 기존에 이미 구현되어 있던
    Point 기반(yolo_detector.py, camera/target_error) 탐색/정렬/하강 파이프라인을 재사용한다.
    완전 착륙이 아니라 hover 고도까지만 하강 후 그리퍼를 열어 페이로드를 내려놓는다.
  -->
  <!-- 현재 MissionSequence에서 미참조 (way3.plan에 드롭존 웨이포인트 없음). -->
  <BehaviorTree ID="DropOperation">
    <RetryUntilSuccessful num_attempts="2">
      <Fallback name="DropOperationWithLocalRecovery">
        <Sequence name="DropOperationAttempt">
          <SetMissionPhase phase="3"/>
          <StartOffboardSetpointStream mode="hold_current_pose" rate_hz="20"/>
          <IsOffboardSetpointStreamAlive min_rate_hz="10" stable_duration_sec="1.0"/>
          <SetFlightMode mode="OFFBOARD" timeout_sec="5.0"/>
          <IsFlightMode mode="OFFBOARD"/>
          <CommandVTOLTransition target_state="MC" timeout_sec="20.0"/>
          <IsVTOLStateMC/>
          <WaitForHoverStable altitude_tolerance_m="40.0" max_vertical_speed_mps="0.8" max_horizontal_speed_mps="2.0" stable_duration_sec="0.5" timeout_sec="12.0"/>
          <SetMissionPhase phase="9"/>
          <ActivateYOLO target="drop_zone" mode="start_or_set_target"/>
          <IsVisionTopicFresh topic="/vision/detections" max_age_sec="0.5"/>
          <Fallback name="SearchOrDetectDropZone">
            <IsObjectDetected target="drop_zone" min_confidence="0.55" stable_frames="3"/>
            <ExecuteSearchPattern target="drop_zone" pattern="spiral_or_lawnmower" max_duration_sec="45.0"/>
          </Fallback>
          <AlignToBasket pixel_tolerance_px="25" yaw_tolerance_rad="0.1" stable_duration_sec="1.0" timeout_sec="35.0"/>
          <DescendWithAlignment target="drop_zone" descent_step_m="0.3" min_confidence="0.55" max_lost_time_sec="0.7" timeout_sec="60.0" target_altitude_m="1.0"/>
          <OpenGripper left_topic="/model/standard_vtol_0/servo_5" right_topic="/model/standard_vtol_0/servo_6" left_position="-1.2" right_position="-1.2" timeout_sec="5.0"/>
          <DeactivateYOLO target="drop_zone"/>
        </Sequence>
        <Sequence name="RecoverDropThenRetry">
          <RecoverVisionLanding policy="hover_climb_reacquire" climb_altitude_m="1.5" timeout_sec="20.0"/>
          <FailAfterRecovery/>
        </Sequence>
      </Fallback>
    </RetryUntilSuccessful>
  </BehaviorTree>

  <!-- 현재 MissionSequence에서 미참조 (way3.plan에 드롭존 웨이포인트 없음). -->
  <BehaviorTree ID="ResumeAfterDrop">
    <Sequence name="ResumeAfterDrop">
      <FlyToAltitude target_altitude_m="30.0" tolerance_m="1.0" max_climb_rate_mps="1.2" hold_latlon="true" timeout_sec="60.0"/>
      <IsAltitudeReached target_altitude_m="30.0" tolerance_m="1.0"/>
      <!-- drop 이후 순항 재개 지점. 실제 .plan 확정 시 조정 -->
      <AlignHeadingToWaypoint seq="999" tolerance_rad="0.05" timeout_sec="8.0"/>
      <SetMissionCurrentWaypoint seq="999" timeout_sec="5.0"/>
      <CommandVTOLTransition target_state="FW" timeout_sec="20.0"/>
      <RetryUntilSuccessful num_attempts="3">
        <Sequence name="ResumeAutoMissionAfterDrop">
          <SetFlightMode mode="AUTO.MISSION" timeout_sec="5.0"/>
          <IsFlightMode mode="AUTO.MISSION"/>
        </Sequence>
      </RetryUntilSuccessful>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="CruiseToLanding">
    <!-- landing_wp_seq (krac_bt_params.yaml 기본값 7 = HOME_RETURN 도착).
         seq8 HOME_VTOL_LAND는 PX4 mission feasibility/safety net이며,
         BT는 seq7에서 OFFBOARD로 개입해 자체 최종 착륙을 수행한다. -->
    <WaitForWaypointReached seq="7" timeout_sec="600.0"/>
  </BehaviorTree>

  <!-- krac24 PHASE_VERTIPORT_DESCENT 이식: precision_lander로 버티포트 정밀 착륙 -->
  <BehaviorTree ID="FinalLanding">
    <RetryUntilSuccessful num_attempts="2">
      <Fallback name="FinalLandingWithLocalRecovery">
        <Sequence name="FinalLandingAttempt">
          <StartOffboardSetpointStream mode="hold_current_pose" rate_hz="20"/>
          <IsOffboardSetpointStreamAlive min_rate_hz="10" stable_duration_sec="1.0"/>
          <SetFlightMode mode="OFFBOARD" timeout_sec="5.0"/>
          <IsFlightMode mode="OFFBOARD"/>
          <CommandVTOLTransition target_state="MC" timeout_sec="20.0"/>
          <IsVTOLStateMC/>
          <WaitForHoverStable altitude_tolerance_m="40.0" max_vertical_speed_mps="0.8" max_horizontal_speed_mps="2.0" stable_duration_sec="0.5" timeout_sec="12.0"/>
          <SetMissionPhase phase="10"/>
          <DeactivateYOLO/>
          <WaitForPrecisionTarget max_age_sec="4.0" timeout_sec="45.0"/>
          <EnablePrecisionLander enable="true"/>
          <PrecisionLandOnTarget target_altitude_m="0.25" timeout_sec="150.0" target_fresh_max_age_sec="10.0"/>
          <EnablePrecisionLander enable="false"/>
          <SetFlightMode mode="AUTO.LAND" timeout_sec="5.0"/>
          <DetectLanding max_relative_altitude_m="0.3" max_vertical_speed_mps="0.2" timeout_sec="45.0"/>
          <VerifyLandingComplete require_disarmed="true" timeout_sec="20.0"/>
          <SetMissionPhase phase="11"/>
        </Sequence>
        <Sequence name="RecoverFinalLandingThenRetry">
          <EnablePrecisionLander enable="false"/>
          <RecoverFinalLanding policy="hover_reacquire_else_autoland" climb_altitude_m="1.0" timeout_sec="20.0"/>
          <FailAfterRecovery/>
        </Sequence>
      </Fallback>
    </RetryUntilSuccessful>
  </BehaviorTree>

  <TreeNodesModel>
    <Condition ID="IsEmergencyDetected" editable="true">
      <input_port name="sources" default="px4_failsafe,mavros_loss,gps_loss,battery_critical,manual_abort,geofence">비상으로 간주할 신호 목록</input_port>
    </Condition>
    <Action ID="EmergencyRecovery" editable="true">
      <input_port name="policy" default="hold_if_possible_else_px4_failsafe">비상 상황 처리 정책</input_port>
    </Action>
    <Action ID="GlobalMissionRecovery" editable="true">
      <input_port name="reason" default="unhandled_failure">전역 미션 실패 복구 사유</input_port>
    </Action>

    <Condition ID="IsMAVROSConnected" editable="true">
      <input_port name="max_state_age_sec" default="0.5">/mavros/state 최신성 허용 시간</input_port>
    </Condition>
    <Condition ID="IsGPSReady" editable="true">
      <input_port name="min_fix_status" default="0">GPS fix 최소 상태</input_port>
    </Condition>
    <Condition ID="IsGlobalPositionFresh" editable="true">
      <input_port name="max_age_sec" default="0.5">global position 메시지 최신성 허용 시간</input_port>
    </Condition>
    <Condition ID="IsBatterySafe" editable="true">
      <input_port name="sim_bypass" default="true">시뮬레이션에서 배터리 체크 우회 여부</input_port>
      <input_port name="min_voltage" default="0.0">최소 전압</input_port>
      <input_port name="min_percentage" default="0.0">최소 잔량 비율</input_port>
    </Condition>

    <Action ID="StartOffboardSetpointStream" editable="true">
      <input_port name="mode" default="hold_current_pose">setpoint stream 방식</input_port>
      <input_port name="rate_hz" default="20">publish rate</input_port>
    </Action>
    <Condition ID="IsOffboardSetpointStreamAlive" editable="true">
      <input_port name="min_rate_hz" default="10">최소 setpoint publish rate</input_port>
      <input_port name="stable_duration_sec" default="1.0">최소 연속 유지 시간</input_port>
    </Condition>
    <Action ID="SetFlightMode" editable="true">
      <input_port name="mode" default="OFFBOARD">PX4 flight mode</input_port>
      <input_port name="timeout_sec" default="5.0">모드 요청 timeout</input_port>
    </Action>
    <Condition ID="IsFlightMode" editable="true">
      <input_port name="mode" default="OFFBOARD">확인할 PX4 flight mode</input_port>
    </Condition>
    <Action ID="ArmVehicle" editable="true">
      <input_port name="arm" default="true">arm 또는 disarm 요청</input_port>
      <input_port name="timeout_sec" default="5.0">arming timeout</input_port>
    </Action>
    <Condition ID="IsVehicleArmed" editable="true"/>
    <Condition ID="IsVTOLStateMC" editable="true"/>
    <Action ID="EnsureFixedWingCruise" editable="true">
      <input_port name="transition_source" default="mission_plan_or_command">FW 전환 출처</input_port>
      <input_port name="timeout_sec" default="45.0">FW 전환 확인 timeout</input_port>
    </Action>
    <Action ID="CommandVTOLTransition" editable="true">
      <input_port name="target_state" default="MC">목표 VTOL 상태</input_port>
      <input_port name="timeout_sec" default="20.0">전환 명령 timeout</input_port>
    </Action>

    <Action ID="FlyToAltitude" editable="true">
      <input_port name="target_altitude_m" default="10.0">목표 상대 고도</input_port>
      <input_port name="tolerance_m" default="1.0">허용 고도 오차</input_port>
      <input_port name="max_climb_rate_mps" default="1.0">최대 상승률</input_port>
      <input_port name="hold_latlon" default="true">현재 lat/lon 유지 여부</input_port>
      <input_port name="timeout_sec" default="60.0">고도 도달 timeout</input_port>
    </Action>
    <Condition ID="IsAltitudeReached" editable="true">
      <input_port name="target_altitude_m" default="10.0">목표 상대 고도</input_port>
      <input_port name="tolerance_m" default="0.5">허용 고도 오차</input_port>
    </Condition>
    <Action ID="WaitForHoverStable" editable="true">
      <input_port name="altitude_tolerance_m" default="0.5">허용 고도 오차</input_port>
      <input_port name="max_vertical_speed_mps" default="0.3">최대 수직 속도</input_port>
      <input_port name="max_horizontal_speed_mps" default="0.5">최대 수평 속도</input_port>
      <input_port name="stable_duration_sec" default="2.0">안정 유지 시간</input_port>
    </Action>

    <Action ID="ClearMissionPlan" editable="true">
      <input_port name="optional" default="true">실패해도 무시 가능한지 여부</input_port>
    </Action>
    <Action ID="UploadMissionPlan" editable="true">
      <input_port name="plan_path" default="way3.plan">업로드할 mission plan 경로</input_port>
      <input_port name="mission_name" default="full_route">mission 이름</input_port>
      <input_port name="expected_end" default="LANDING">예상 종료 지점</input_port>
    </Action>
    <Condition ID="IsMissionUploaded" editable="true">
      <input_port name="mission_name" default="full_route">확인할 mission 이름</input_port>
      <input_port name="expected_end" default="LANDING">예상 종료 지점</input_port>
    </Condition>
    <Condition ID="IsRescueCompleted" editable="true"/>
    <Action ID="EnterREPStation" editable="true">
