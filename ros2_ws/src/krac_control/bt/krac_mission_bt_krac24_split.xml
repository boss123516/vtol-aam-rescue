    </Action>
    <Action ID="GlobalMissionRecovery" editable="true">
      <input_port name="reason" default="unhandled_failure">전역 미션 실패 복구 사유</input_port>
    </Action>
    <Condition ID="IsMAVROSConnected" editable="true">
