<?xml version='1.0' encoding='UTF-8'?>
<root BTCPP_format="4" main_tree_to_execute="KRAC_Mission_BT">
  <BehaviorTree ID="KRAC_Mission_BT">
    <ReactiveFallback name="RootReactiveFallback">
      <Sequence name="EmergencyBranch">
        <IsEmergencyDetected sources="px4_failsafe,mavros_loss,gps_loss,battery_critical,manual_abort,geofence" />
        <EmergencyRecovery policy="hold_if_possible_else_px4_failsafe" />
      </Sequence>
      <Fallback name="MissionOrHoldRecovery">
        <ReactiveSequence name="SafetyGuardedMission">
          <Sequence name="SafetyGuard">
            <IsMAVROSConnected max_state_age_sec="5.0" />
            <IsBatterySafe sim_bypass="true" min_voltage="0.0" min_percentage="0.0" />
          </Sequence>
          <Sequence name="MissionSequenceSplit">
            <Sequence name="StartRescueLeg">
              <ClearMissionPlan optional="true" />
              <RetryUntilSuccessful num_attempts="2">
                <Sequence name="LoadRescueLeg">
                  <UploadMissionPlan plan_path="krac24_rescue_leg.plan" mission_name="rescue_leg" expected_end="REP" />
                  <IsMissionUploaded mission_name="rescue_leg" expected_end="REP" />
                </Sequence>
              </RetryUntilSuccessful>
              <SetMissionPhase phase="0" />
              <RetryUntilSuccessful num_attempts="3">
                <ArmVehicle arm="true" timeout_sec="5.0" />
              </RetryUntilSuccessful>
              <RetryUntilSuccessful num_attempts="3">
                <SetFlightMode mode="AUTO.MISSION" timeout_sec="8.0" />
              </RetryUntilSuccessful>
            </Sequence>
            <SetMissionPhase phase="1" />
            <WaitForWaypointReached seq="6" match="after_start" timeout_sec="600.0" />
            <Sequence name="TakeOverAtREP">
              <StartOffboardSetpointStream mode="hold_current_pose" rate_hz="20" />
              <Delay delay_msec="1500">
                <AlwaysSuccess />
              </Delay>
              <IsOffboardSetpointStreamAlive min_rate_hz="10" stable_duration_sec="1.0" />
              <RetryUntilSuccessful num_attempts="3">
                <SetFlightMode mode="OFFBOARD" timeout_sec="8.0" />
              </RetryUntilSuccessful>
              <ClearMissionPlan optional="true" />
            </Sequence>
            <SubTree ID="RescuePickupModule" />
            <SetMissionPhase phase="9" />
            <RetryUntilSuccessful num_attempts="2">
              <Sequence name="UploadReturnLeg">
                <ClearMissionPlan optional="true" />
                <UploadMissionPlan plan_path="krac24_return_leg.plan" mission_name="return_leg" expected_end="LANDING" />
                <IsMissionUploaded mission_name="return_leg" expected_end="LANDING" />
              </Sequence>
            </RetryUntilSuccessful>
            <RetryUntilSuccessful num_attempts="3">
              <SetFlightMode mode="AUTO.MISSION" timeout_sec="8.0" />
            </RetryUntilSuccessful>
            <WaitForWaypointReached seq="1" match="after_start" timeout_sec="180.0" />
            <Sequence name="AlignAndTransitionToFW">
              <StartOffboardSetpointStream mode="hold_current_pose" rate_hz="20" />
              <Delay delay_msec="1500">
                <AlwaysSuccess />
              </Delay>
              <IsOffboardSetpointStreamAlive min_rate_hz="10" stable_duration_sec="1.0" />
              <RetryUntilSuccessful num_attempts="3">
                <SetFlightMode mode="OFFBOARD" timeout_sec="8.0" />
              </RetryUntilSuccessful>
              <WaitForHoverStable altitude_tolerance_m="2.0" max_vertical_speed_mps="0.6" max_horizontal_speed_mps="1.0" stable_duration_sec="1.0" timeout_sec="15.0" />
              <AlignHeadingToWaypoint seq="3" tolerance_rad="0.20" timeout_sec="30.0" />
              <CommandVTOLTransition target_state="FW" timeout_sec="45.0" />
              <SetMissionCurrentWaypoint seq="3" timeout_sec="8.0" />
              <SetFlightMode mode="AUTO.MISSION" timeout_sec="8.0" />
            </Sequence>
            <WaitForWaypointReached seq="7" match="after_start" timeout_sec="600.0" />
            <SetMissionPhase phase="10" />
            <DetectLanding max_relative_altitude_m="0.4" max_vertical_speed_mps="0.3" timeout_sec="180.0" />
            <Fallback name="FinalDisarmOrAlreadyDisarmed">
              <Inverter>
                <IsVehicleArmed />
              </Inverter>
              <Sequence>
                <ArmVehicle arm="false" timeout_sec="10.0" />
                <Inverter>
                  <IsVehicleArmed />
                </Inverter>
              </Sequence>
            </Fallback>
            <SetMissionPhase phase="11" />
          </Sequence>
        </ReactiveSequence>
        <GlobalMissionRecovery reason="unhandled_mission_or_guard_failure" />
      </Fallback>
    </ReactiveFallback>
  </BehaviorTree>
  <BehaviorTree ID="RescuePickupModule">
    <Sequence name="RescuePlaceholderCycle">
      <CommandVTOLTransition target_state="MC" timeout_sec="20.0" />
      <FlyToLocalPoint x_m="-26.03" y_m="-31.41" z_m="3.0" xy_tolerance_m="0.5" z_tolerance_m="0.45" max_xy_speed_mps="1.2" max_z_speed_mps="0.7" timeout_sec="60.0" />
      <WaitForHoverStable altitude_tolerance_m="0.7" max_vertical_speed_mps="0.3" max_horizontal_speed_mps="0.5" stable_duration_sec="1.5" timeout_sec="15.0" />
      <ExecuteExternalRescueModule enable_topic="/krac/rescue_module/enable" ready_topic="/krac/rescue_module/ready" result_topic="/krac/rescue_module/result" request_rate_hz="2.0" handover_timeout_sec="30.0" execution_timeout_sec="260.0" handback_hold_sec="1.0" />
    </Sequence>
  </BehaviorTree>
  <TreeNodesModel>
    <Condition ID="IsEmergencyDetected" editable="true">
      <input_port name="sources" default="px4_failsafe,mavros_loss,gps_loss,battery_critical,manual_abort,geofence">비상으로 간주할 신호 목록</input_port>
    </Condition>
    <Action ID="EmergencyRecovery" editable="true">
