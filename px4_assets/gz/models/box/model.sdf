<?xml version="1.0" ?>
<sdf version="1.6">
  <!--
    box.dae raw mesh bounding box is 230x170x174mm (origin at bottom-center,
    z starts at 0). scale must be 0.001 (mm->m, same convention as
    survivor_tray) to come out to 0.23 x 0.17 x 0.174m - matching the tray's
    own 0.237x0.137m footprint. The previous 0.003 scale made it 0.69 x 0.51 x
    0.522m (3x too big in every dimension), which combined with auto_spawn.sh
    floating it at z=0.5 caused the vehicle to physically collide with/get
    snagged on this oversized static box during precision descent/gripper ops.
  -->
  <model name="box_dae">
    <!--
      2026-07-15: 그리퍼로 이 박스를 실제로 집으려고 static 을 풀었다.
      과거의 "착륙 중 기체가 21m 날아간" 사고는 static 인 채로 '풀메시' collider 가
      AUTO.LAND 접지 경로에 박혀 있었던 조건에서 났다. 여기서는 그 두 조건을 모두
      없앤다: (1) static 해제 -> 밀리면 밀리는 정상 강체, (2) collision 은 메시가
      아니라 단순 box primitive. 메시는 visual 로만 쓴다.

      집게 기하(standard_vtol 패치의 gripper_body z=-0.11 기준):
        손가락 -60도=211mm(최대) / -45도=177mm / -43도쯤=170mm / -30도=138mm
      짧은변 170mm 는 -43도 근처에서 물린다. 그때 손끝이 지면 위 ~30mm 라 높이
      174mm 박스 옆면에 충분히 닿는다. 긴변 230mm 는 최대 211mm 를 넘어 못 문다
      - 반드시 짧은변으로 접근해야 한다.

      YOLO 가 실제로 보는 것도 (트레이가 아니라) 이 박스다: 실측 OBB 종횡비가
      1.14~1.49 로 박스(230/170=1.35)와 맞고 트레이(237/137=1.73)와는 안 맞았다.
    -->
    <static>false</static>
    <link name="link">
      <inertial>
        <pose>0 0 0.087 0 0 0</pose>
        <mass>0.5</mass>
        <!-- 균일 직육면체 0.23 x 0.17 x 0.174, m=0.5 -->
        <inertia>
          <ixx>0.00246</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.00346</iyy><iyz>0</iyz>
          <izz>0.00341</izz>
        </inertia>
      </inertial>

      <collision name="collision">
        <pose>0 0 0.087 0 0 0</pose>
        <geometry>
          <box><size>0.23 0.17 0.174</size></box>
        </geometry>
        <surface>
          <friction><ode><mu>1.5</mu><mu2>1.5</mu2></ode></friction>
        </surface>
      </collision>

      <visual name="visual">
        <geometry>
          <mesh>
            <uri>model://box/meshes/box.dae</uri>
            <scale>0.001 0.001 0.001</scale>
          </mesh>
        </geometry>
      </visual>
    </link>
  </model>
</sdf>
