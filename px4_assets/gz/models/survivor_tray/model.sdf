<?xml version="1.0"?>
<sdf version="1.6">
  <!--
    survivor_tray Gazebo model
    Source STL was recentered for simulation.
    Model frame/origin: bottom-center of the tray.
    Axis convention: X = tray long side, Y = tray short side, Z = up.
    Visual mesh units: millimeters, so scale is 0.001 0.001 0.001.
    STL measured bounding box after scale: 0.237 m x 0.137 m x 0.070 m.
  -->
  <model name="survivor_tray">
    <static>false</static>

    <link name="tray_link">
      <inertial>
        <mass>0.25</mass>
        <inertia>
          <ixx>0.0006</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.0011</iyy>
          <iyz>0</iyz>
          <izz>0.0014</izz>
        </inertia>
      </inertial>

      <visual name="tray_visual">
        <geometry>
          <mesh>
            <uri>model://survivor_tray/meshes/survivor_tray.stl</uri>
            <scale>0.001 0.001 0.001</scale>
          </mesh>
        </geometry>
        <material>
          <ambient>1.0 1.0 1.0 1.0</ambient>
          <diffuse>1.0 1.0 1.0 1.0</diffuse>
        </material>
      </visual>

      <!-- Collision is simplified into tray floor + four walls + four legs.
           This is more stable than using the detailed STL mesh as collision. -->
      <collision name="tray_floor_collision">
        <pose>0 0 0.0415 0 0 0</pose>
        <geometry>
          <box>
            <size>0.2370 0.1370 0.0030</size>
          </box>
        </geometry>
      </collision>

      <collision name="front_wall_collision">
        <pose>0 0.0670 0.0550 0 0 0</pose>
        <geometry>
          <box>
            <size>0.2370 0.0030 0.0300</size>
          </box>
        </geometry>
      </collision>

      <collision name="back_wall_collision">
        <pose>0 -0.0670 0.0550 0 0 0</pose>
        <geometry>
          <box>
            <size>0.2370 0.0030 0.0300</size>
          </box>
        </geometry>
      </collision>

      <collision name="left_wall_collision">
        <pose>-0.1170 0 0.0550 0 0 0</pose>
        <geometry>
          <box>
            <size>0.0030 0.1370 0.0300</size>
          </box>
        </geometry>
      </collision>

      <collision name="right_wall_collision">
        <pose>0.1170 0 0.0550 0 0 0</pose>
        <geometry>
          <box>
            <size>0.0030 0.1370 0.0300</size>
          </box>
        </geometry>
      </collision>

      <collision name="leg_fl_collision">
        <pose>0.1035 0.0535 0.0200 0 0 0</pose>
        <geometry><box><size>0.0100 0.0100 0.0400</size></box></geometry>
      </collision>
      <collision name="leg_fr_collision">
        <pose>0.1035 -0.0535 0.0200 0 0 0</pose>
        <geometry><box><size>0.0100 0.0100 0.0400</size></box></geometry>
      </collision>
      <collision name="leg_bl_collision">
        <pose>-0.1035 0.0535 0.0200 0 0 0</pose>
        <geometry><box><size>0.0100 0.0100 0.0400</size></box></geometry>
      </collision>
      <collision name="leg_br_collision">
        <pose>-0.1035 -0.0535 0.0200 0 0 0</pose>
        <geometry><box><size>0.0100 0.0100 0.0400</size></box></geometry>
      </collision>
    </link>
  </model>
</sdf>
