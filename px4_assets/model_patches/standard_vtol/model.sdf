    <include merge='true'>
      <uri>model://mono_cam</uri>
      <pose>0.2 0 -0.07 0 1.5707 0</pose>
      <name>mono_cam</name>
    </include>
    <joint name="camera_joint" type="fixed">
      <parent>base_link</parent>
      <child>camera_link</child>
    </joint>
    <static>0</static>

    <link name="gripper_body">
      <pose>0.0 0 -0.08 0 0 0</pose>
      <inertial>
        <mass>0.6</mass>
        <inertia><ixx>0.002</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.001</iyy><iyz>0</iyz><izz>0.001</izz></inertia>
      </inertial>

      <visual name="gripper_body_visual">
        <geometry>
          <mesh>
            <scale>0.001 0.001 0.001</scale>
            <uri>model://amsr_vtol/meshes/Gripper_body.stl</uri>
          </mesh>
        </geometry>
        <material><ambient>0.15 0.15 0.18 1</ambient><diffuse>0.2 0.2 0.24 1</diffuse></material>
      </visual>

      <collision name="gripper_body_collision">
        <geometry><box><size>0.12 0.12 0.02</size></box></geometry>
      </collision>
    </link>

    <joint name="gripper_z_rotation_joint" type="revolute">
      <parent>base_link</parent>
      <child>gripper_body</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit><lower>-3.1415</lower><upper>3.1415</upper><effort>10.0</effort><velocity>2.0</velocity></limit>
      </axis>
    </joint>

    <link name="left_hand_link">
      <pose relative_to="gripper_body">0 0.06 -0.01 0 0 0</pose> <inertial>
        <mass>0.1</mass>
        <inertia><ixx>2e-4</ixx><ixy>0</ixy><ixz>0</ixz><iyy>2e-4</iyy><iyz>0</iyz><izz>2e-4</izz></inertia>
      </inertial>

      <visual name="gripper_hand1_visual">
        <pose>0.03 0 0 0 0 0</pose>
        <geometry><mesh><scale>0.001 0.001 0.001</scale><uri>model://amsr_vtol/meshes/gripper_hand2.stl</uri></mesh></geometry>
        <material><ambient>0.6 0.6 0.62 1</ambient><diffuse>0.7 0.7 0.72 1</diffuse></material>
      </visual>

      <visual name="gripper_hand2_visual">
        <pose>-0.03 0 0 0 0 0</pose>
        <geometry><mesh><scale>0.001 0.001 0.001</scale><uri>model://amsr_vtol/meshes/gripper_hand3.stl</uri></mesh></geometry>
        <material><ambient>0.6 0.6 0.62 1</ambient><diffuse>0.7 0.7 0.72 1</diffuse></material>
      </visual>

      <collision name="left_hand_collision_arm1">
        <pose>0.03 0.02 -0.04 -0.4 0 0</pose>
        <geometry><box><size>0.02 0.01 0.06</size></box></geometry>
        <surface><friction><ode><mu>1.5</mu><mu2>1.5</mu2></ode></friction></surface>
      </collision>
      <collision name="left_hand_collision_arm2">
        <pose>-0.03 0.02 -0.04 -0.4 0 0</pose>
        <geometry><box><size>0.02 0.01 0.06</size></box></geometry>
        <surface><friction><ode><mu>1.5</mu><mu2>1.5</mu2></ode></friction></surface>
      </collision>
      <collision name="left_hand_collision_leg1">
        <pose>0.03 -0.01 -0.075 0 0 0</pose>
        <geometry><box><size>0.02 0.04 0.01</size></box></geometry>
        <surface><friction><ode><mu>1.5</mu><mu2>1.5</mu2></ode></friction></surface>
      </collision>
      <collision name="left_hand_collision_leg2">
        <pose>-0.03 -0.01 -0.075 0 0 0</pose>
        <geometry><box><size>0.02 0.04 0.01</size></box></geometry>
        <surface><friction><ode><mu>1.5</mu><mu2>1.5</mu2></ode></friction></surface>
      </collision>
    </link>

    <joint name="left_hand_joint" type="revolute">
      <parent>gripper_body</parent>
      <child>left_hand_link</child>
      <axis>
        <xyz>-1 0 0</xyz>
        <limit><lower>-1.57</lower><upper>1.57</upper><effort>5.0</effort><velocity>1.5</velocity></limit>
      </axis>
    </joint>


    <link name="right_hand_link">
      <pose relative_to="gripper_body">0 -0.06 -0.01 0 0 0</pose> <inertial>
        <mass>0.1</mass>
        <inertia><ixx>2e-4</ixx><ixy>0</ixy><ixz>0</ixz><iyy>2e-4</iyy><iyz>0</iyz><izz>2e-4</izz></inertia>
      </inertial>

      <visual name="gripper_hand3_visual">
        <pose>0.03 0 0 0 0 0</pose>
        <geometry><mesh><scale>0.001 0.001 0.001</scale><uri>model://amsr_vtol/meshes/gripper_hand1_v1.stl</uri></mesh></geometry>
        <material><ambient>0.6 0.6 0.62 1</ambient><diffuse>0.7 0.7 0.72 1</diffuse></material>
      </visual>

      <visual name="gripper_hand4_visual">
        <pose>-0.03 0 0 0 0 0</pose>
        <geometry><mesh><scale>0.001 0.001 0.001</scale><uri>model://amsr_vtol/meshes/gripper_hand4.stl</uri></mesh></geometry>
        <material><ambient>0.6 0.6 0.62 1</ambient><diffuse>0.7 0.7 0.72 1</diffuse></material>
      </visual>

      <collision name="right_hand_collision_arm1">
        <pose>0.03 -0.02 -0.04 0.4 0 0</pose>
        <geometry><box><size>0.02 0.01 0.06</size></box></geometry>
        <surface><friction><ode><mu>1.5</mu><mu2>1.5</mu2></ode></friction></surface>
      </collision>
      <collision name="right_hand_collision_arm2">
        <pose>-0.03 -0.02 -0.04 0.4 0 0</pose>
        <geometry><box><size>0.02 0.01 0.06</size></box></geometry>
        <surface><friction><ode><mu>1.5</mu><mu2>1.5</mu2></ode></friction></surface>
      </collision>
      <collision name="right_hand_collision_leg1">
        <pose>0.03 0.01 -0.075 0 0 0</pose>
        <geometry><box><size>0.02 0.04 0.01</size></box></geometry>
        <surface><friction><ode><mu>1.5</mu><mu2>1.5</mu2></ode></friction></surface>
      </collision>
      <collision name="right_hand_collision_leg2">
        <pose>-0.03 0.01 -0.075 0 0 0</pose>
        <geometry><box><size>0.02 0.04 0.01</size></box></geometry>
        <surface><friction><ode><mu>1.5</mu><mu2>1.5</mu2></ode></friction></surface>
      </collision>
    </link>

    <joint name="right_hand_joint" type="revolute">
      <parent>gripper_body</parent>
      <child>right_hand_link</child>
      <axis>
        <xyz>1 0 0</xyz>
        <limit><lower>-1.57</lower><upper>1.57</upper><effort>5.0</effort><velocity>1.5</velocity></limit>
      </axis>
    </joint>


    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>gripper_z_rotation_joint</joint_name>
      <sub_topic>servo_4</sub_topic>
      <p_gain>10.0</p_gain> <i_gain>0.0</i_gain> <d_gain>0.1</d_gain>
    </plugin>

    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>left_hand_joint</joint_name>
      <sub_topic>servo_5</sub_topic>
      <p_gain>10.0</p_gain> <i_gain>0.0</i_gain> <d_gain>0.1</d_gain>
    </plugin>

    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>right_hand_joint</joint_name>
      <sub_topic>servo_6</sub_topic>
      <p_gain>10.0</p_gain> <i_gain>0.0</i_gain> <d_gain>0.1</d_gain>
    </plugin>

    <plugin filename="gz-sim-detachable-joint-system" name="gz::sim::systems::DetachableJoint">
      <parent_link>gripper_body</parent_link>
      <child_model>survivor_tray_rep</child_model>
      <child_link>tray_link</child_link>
      <attach_topic>/survivor_tray_rep/attach</attach_topic>
      <detach_topic>/survivor_tray_rep/detach</detach_topic>
      <output_topic>/survivor_tray_rep/gripper_state</output_topic>
      <suppress_child_warning>true</suppress_child_warning>
    </plugin>

  </model>
</sdf>
